# Copy to /opt/ai-api/runtime/app.env; owner root, mode 0600.
# Use the existing private store. Verify the branch from Render before cutover.
GITSTORE_GIT_URL=https://github.com/kv9898/AI-API.git
GITSTORE_GIT_USERNAME=kv9898
GITSTORE_GIT_BRANCH=REPLACE_WITH_VERIFIED_BRANCH
GITSTORE_GIT_TOKEN=REPLACE_WITH_REPOSITORY_SCOPED_TOKEN
# Do not add PGSTORE_* or OBJECTSTORE_*; they take precedence over Git storage.
